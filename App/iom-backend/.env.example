PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/icepik_octo_manager
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BASE_WEB_URL=http://localhost:3000

# Required for actual printer operations. Keys stay in the backend .env.
# ED1 replaces EnderDirect; ED2 replaces EnderMultiColor.
OCTOPRINT_ED1_URL=http://192.168.1.34/ED1
OCTOPRINT_ED1_API_KEY=
OCTOPRINT_ED2_URL=http://192.168.1.34/ED2
OCTOPRINT_ED2_API_KEY=

# Legacy fallback settings (optional).
OCTOPRINT_BASE_URL=
OCTOPRINT_API_KEY=
OCTOPRINT_MULTICOLOR_PATH=
OCTOPRINT_DIRECT_PATH=
SMTP_USER=
SMTP_PASS=

# Local web origins; set your HTTPS origin and COOKIE_SECURE=true when hosted.
WEB_ORIGINS=http://127.0.0.1:3002,http://localhost:3002,http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
HOST=127.0.0.1
